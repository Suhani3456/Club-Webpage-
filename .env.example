# Server
PORT=3000
# development or production (secure cookies in production)
NODE_ENV=development

# MongoDB connection string (local mongod or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/coding-club

# Secret used to sign session JWTs — change this to a long random string
JWT_SECRET=change-me-to-a-long-random-string

# SMTP settings for sending verification / password-reset emails.
# Free option: Brevo (300 emails/day free):
#   1. Sign up at brevo.com.
#   2. Senders & IP:  add and VERIFY your sender address (e.g. your college
#      email). MAIL_FROM must be exactly that verified address, or Brevo
#      rejects the mail (550) and nothing arrives.
#   3. SMTP & API:  create an SMTP key. The login looks like
#      xxxx@smtp-brevo.com and the key is shown once — paste both below.
#   4. SMTP & API > Authorised IPs:  add your IP if Brevo requires it
#      (a blocked IP shows as a connect/auth error at startup).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=xxxx@smtp-brevo.com
SMTP_PASS=
MAIL_FROM="Coding Club <your-verified-sender@example.com>"
#
# Port 587 uses STARTTLS (secure=false + requireTLS=true). Port 465 would use
# implicit TLS instead — both work; 587 is what Brevo documents.
# Gmail also works: smtp.gmail.com:465 with an app password.
#